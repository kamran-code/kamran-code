{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ESAT question batch",
  "type": "object",
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/question" }
    }
  },
  "required": ["questions"],
  "definitions": {
    "question": {
      "type": "object",
      "properties": {
        "section": {
          "type": "string",
          "enum": ["mathematics1", "physics", "chemistry", "biology", "mathematics2"]
        },
        "topic": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
        "question": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 5,
          "maxItems": 5
        },
        "correctIndex": { "type": "integer", "minimum": 0, "maximum": 4 },
        "explanation": { "type": "string", "minLength": 1 }
      },
      "required": ["section", "difficulty", "question", "options", "correctIndex", "explanation"],
      "additionalProperties": false
    }
  }
}
