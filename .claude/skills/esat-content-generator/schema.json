{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ESAT question batch",
  "type": "object",
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/question" }
    }
  },
  "required": ["questions"],
  "definitions": {
    "question": {
      "type": "object",
      "properties": {
        "section": {
          "type": "string",
          "enum": ["mathematics1", "physics", "mathematics2"]
        },
        "topic": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
        "question": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 4,
          "maxItems": 8
        },
        "correctIndex": { "type": "integer", "minimum": 0, "maximum": 7 },
        "explanation": { "type": "string", "minLength": 1 },
        "image": {
          "type": "string",
          "description": "Optional figure: inline SVG markup, a data: URI, or an http(s) URL. Rendered inside an <img> (SVG scripts are neutralized). Max ~500 KB."
        },
        "imageAlt": {
          "type": "string",
          "description": "Optional short text description of the figure."
        }
      },
      "required": ["section", "difficulty", "question", "options", "correctIndex", "explanation"],
      "additionalProperties": false
    }
  }
}
