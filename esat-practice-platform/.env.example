# Anthropic API key — required for AI question generation.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used for generation.
# Defaults to claude-sonnet-5 (fast, high quality for MCQ generation).
# Use claude-opus-5 for maximum quality.
ANTHROPIC_MODEL=claude-sonnet-5
