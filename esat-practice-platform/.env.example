# Token that authorizes content writes (add/update/delete) via the API.
# Generate a long random value, e.g.:  openssl rand -hex 32
# Without it set, write endpoints are disabled in production (503).
INGEST_TOKEN=change-me-to-a-long-random-string

# Password for the admin dashboard (/dashboard). Without it, the dashboard is
# disabled. Choose a strong value.
DASHBOARD_PASSWORD=change-me-to-a-strong-password

# Where the question store lives. In production set this to a path OUTSIDE the
# app dir (e.g. /var/lib/esat-prep) so content survives deploys.
ESAT_DATA_DIR=/var/lib/esat-prep
