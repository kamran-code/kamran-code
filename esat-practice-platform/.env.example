# Token that authorizes pushing content to POST /api/questions/import.
# Generate a long random value, e.g.:  openssl rand -hex 32
# Without it set, write endpoints are disabled in production (503).
INGEST_TOKEN=change-me-to-a-long-random-string

# Where runtime-pushed content is stored. In production set this to a path
# OUTSIDE the app dir (e.g. /var/lib/esat-prep) so content survives deploys.
ESAT_DATA_DIR=/var/lib/esat-prep
